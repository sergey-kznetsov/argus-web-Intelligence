ARGUS_HOST=127.0.0.1
ARGUS_PORT=8787
ARGUS_TOKEN_FILE=.argus/token

# Local development uses embedded execution. Geo Analyzer deployment overrides this
# separately for the API process (api) and the collection worker process (worker).
# ARGUS refuses non-loopback application binds.
ARGUS_EXECUTION_ROLE=embedded

# Local/dev storage. The Geo Analyzer deployment manifest overrides this to postgresql.
ARGUS_STORAGE_BACKEND=sqlite
ARGUS_DB_PATH=.argus/argus.sqlite3

# Product/server PostgreSQL. Geo Analyzer normally supplies the GEOANALYZER_* equivalents
# and ARGUS prefers the DSN secret file when both forms are available. On POSIX, configured
# secret files are hardened and verified as owner-only before services start.
ARGUS_DATABASE_DSN=
ARGUS_DATABASE_DSN_FILE=
ARGUS_POSTGRES_POOL_MIN_SIZE=1
ARGUS_POSTGRES_POOL_MAX_SIZE=8
ARGUS_POSTGRES_POOL_TIMEOUT_SECONDS=30
ARGUS_POSTGRES_POOL_MAX_WAITING=32

# Server worker queue. These settings are used only by ARGUS_EXECUTION_ROLE=worker/api.
ARGUS_WORKER_CONCURRENCY=2
ARGUS_WORKER_POLL_INTERVAL_SECONDS=1
ARGUS_WORKER_LEASE_SECONDS=90
ARGUS_WORKER_HEARTBEAT_SECONDS=20
ARGUS_WORKER_HEALTH_MAX_AGE_SECONDS=60

# Admission backpressure for new server collections. Retries of an already-admitted
# idempotent request return the existing collection even when these limits are full.
ARGUS_QUEUE_MAX_ACTIVE_COLLECTIONS=500
ARGUS_QUEUE_MAX_ACTIVE_PER_CONSUMER=100
ARGUS_QUEUE_RETRY_AFTER_SECONDS=15

# Idempotency protects transport retries only. After this window the same request/key
# may intentionally create a fresh collection again.
ARGUS_IDEMPOTENCY_WINDOW_SECONDS=86400

# Automatic PostgreSQL retention runs from workers under a shared advisory lock.
# Active queued/running collections are never purged. Snapshot cleanup always retains
# the newest snapshot for every source URL as the baseline for future diffs. A terminal
# collection that was recently read remains protected for the configured grace period.
ARGUS_RETENTION_MAINTENANCE_INTERVAL_SECONDS=3600
ARGUS_RETENTION_COLLECTION_DAYS=180
ARGUS_RETENTION_SNAPSHOT_DAYS=365
ARGUS_RETENTION_WORKER_REGISTRATION_DAYS=7
ARGUS_RETENTION_RESULT_ACCESS_GRACE_SECONDS=3600
ARGUS_RETENTION_BATCH_SIZE=500

# Maximum inbound HTTP request body accepted by ARGUS API, including chunked bodies.
ARGUS_API_MAX_REQUEST_BYTES=1048576

# Direct-peer token bucket protecting the internal API process. X-Forwarded-For is not
# trusted by this limiter. /v1/health remains exempt for service orchestration.
ARGUS_API_RATE_LIMIT_REQUESTS_PER_MINUTE=600
ARGUS_API_RATE_LIMIT_BURST=120

# Full-result reads are kept for small collections; larger results use bounded keyset pages.
ARGUS_API_FULL_RESULT_MAX_ITEMS=100
ARGUS_API_FULL_RESULT_MAX_BYTES=4194304
ARGUS_API_RESULT_PAGE_DEFAULT_SIZE=50
ARGUS_API_RESULT_PAGE_MAX_SIZE=100
ARGUS_API_RESULT_PAGE_MAX_BYTES=2097152

ARGUS_LOG_LEVEL=INFO

ARGUS_MAX_RESPONSE_BYTES=5242880

# Untrusted PDF extraction is local and isolated in a short-lived child process.
# The HTTP response limit is applied before these parser-specific limits.
ARGUS_PDF_MAX_BYTES=5242880
ARGUS_PDF_MAX_PAGES=60
ARGUS_PDF_MAX_TEXT_CHARS=250000
ARGUS_PDF_EXTRACT_TIMEOUT_SECONDS=20
ARGUS_PDF_EXTRACT_MEMORY_MB=512

# Public CSV/TSV/JSON normalization is local, deterministic and network-free.
# Transport limits are applied first; these limits bound normalized result size/shape.
ARGUS_STRUCTURED_DATA_MAX_BYTES=5242880
ARGUS_STRUCTURED_DATA_MAX_RECORDS=1000
ARGUS_STRUCTURED_DATA_MAX_COLUMNS=100
ARGUS_STRUCTURED_DATA_MAX_CELL_CHARS=10000
ARGUS_STRUCTURED_DATA_MAX_JSON_DEPTH=32
ARGUS_STRUCTURED_DATA_MAX_JSON_NODES=20000

ARGUS_HTTP_TIMEOUT_SECONDS=30
ARGUS_HTTP_MAX_REDIRECTS=10
ARGUS_BROWSER_TIMEOUT_SECONDS=45
ARGUS_FETCH_WAIT_TIMEOUT_SECONDS=180

ARGUS_MAX_CONCURRENCY=4
ARGUS_BROWSER_MAX_CONCURRENCY=2
ARGUS_FAST_MAX_REQUESTS_PER_MINUTE=120
ARGUS_BROWSER_MAX_REQUESTS_PER_MINUTE=30
ARGUS_PER_DOMAIN_DELAY_SECONDS=1.0
ARGUS_THROTTLED_DOMAINS=
ARGUS_THROTTLE_BASE_DELAY_SECONDS=2
ARGUS_THROTTLE_MAX_DELAY_SECONDS=60

# Application egress policy for arbitrary public crawl targets. Explicitly allowlisted
# internal targets may use another port, but the deny-list always wins. Deployment-level
# firewall/namespace egress rules are still required as the final network boundary.
ARGUS_OUTBOUND_PUBLIC_PORTS=80,443
ARGUS_DENY_OUTBOUND_HOSTS=

# Shared bounded retry policy for direct HTTP providers (Overpass/Nominatim/Wayback/etc.).
ARGUS_DIRECT_PROVIDER_MAX_RETRIES=2
ARGUS_DIRECT_PROVIDER_RETRY_BASE_SECONDS=1
ARGUS_DIRECT_PROVIDER_RETRY_MAX_SECONDS=30

# Discovery providers are ordered fallbacks. SearXNG is preferred when configured.
ARGUS_DISCOVERY_MAX_QUERIES=8
ARGUS_SEARXNG_URL=
ARGUS_SEARXNG_TIMEOUT_SECONDS=15
ARGUS_SEARXNG_MAX_RESULTS_PER_QUERY=10

# Free low-volume Playwright fallback through DuckDuckGo HTML.
# It never bypasses CAPTCHA/anti-bot challenges and may be disabled explicitly.
ARGUS_BROWSER_SERP_ENABLED=true
ARGUS_BROWSER_SERP_MAX_RESULTS_PER_QUERY=5
ARGUS_BROWSER_SERP_WAIT_MS=750

# Best-effort same-host robots.txt/Sitemap navigation. Sitemap URLs are discovery only;
# every selected page still goes through the normal Generic Web evidence pipeline.
ARGUS_SITEMAP_DISCOVERY_ENABLED=true
ARGUS_SITEMAP_MAX_URLS=20
ARGUS_SITEMAP_MAX_INDEXES=5

# Optional OpenStreetMap Overpass provider. No public endpoint is enabled by default.
# Configure a self-hosted or explicitly approved Overpass interpreter endpoint.
ARGUS_OVERPASS_URL=
ARGUS_OVERPASS_TIMEOUT_SECONDS=30
ARGUS_OVERPASS_MIN_INTERVAL_SECONDS=1

# Optional address-to-coordinate provider for map searches without territory.point.
# No public Nominatim endpoint is enabled by default; self-host or explicitly approve one.
ARGUS_NOMINATIM_URL=
ARGUS_NOMINATIM_TIMEOUT_SECONDS=15
ARGUS_NOMINATIM_MAX_RESULTS=3
ARGUS_NOMINATIM_MIN_INTERVAL_SECONDS=1

# Optional exact-URL historical capture discovery through a Wayback CDX server.
# No CDX endpoint is enabled automatically. For Internet Archive public CDX, configure:
# ARGUS_WAYBACK_CDX_URL=https://web.archive.org/cdx/search/cdx
ARGUS_WAYBACK_CDX_URL=
ARGUS_WAYBACK_CAPTURE_BASE_URL=https://web.archive.org/web
ARGUS_WAYBACK_TIMEOUT_SECONDS=20
ARGUS_WAYBACK_MAX_CAPTURES=5
ARGUS_WAYBACK_MIN_INTERVAL_SECONDS=2

# Local LLM assists research planning, exact-excerpt intent classification and the
# optional deterministic AGENT path. ARGUS never treats model output as Evidence.
# ollama-recipe only selects prevalidated public-page controls; Playwright performs and
# verifies the resulting SiteRecipe. Browser Use is currently unavailable because its
# pypdf pin conflicts with ARGUS's patched PDF security baseline.
ARGUS_OLLAMA_URL=http://127.0.0.1:11434
ARGUS_OLLAMA_MODEL=qwen3:8b
ARGUS_AGENT_BACKEND=ollama-recipe
ARGUS_AGENT_ENABLED=false

# Comma-separated exact internal hosts/IPs explicitly allowed for private/internal targets.
# These are operator-managed exceptions and should remain minimal.
ARGUS_ALLOW_INTERNAL_TARGETS=
