ARGUS_HOST=127.0.0.1
ARGUS_PORT=8787
ARGUS_TOKEN_FILE=.argus/token
ARGUS_DB_PATH=.argus/argus.sqlite3
ARGUS_LOG_LEVEL=INFO

ARGUS_MAX_RESPONSE_BYTES=5242880
ARGUS_HTTP_TIMEOUT_SECONDS=30
ARGUS_HTTP_MAX_REDIRECTS=10
ARGUS_BROWSER_TIMEOUT_SECONDS=45
ARGUS_FETCH_WAIT_TIMEOUT_SECONDS=180

ARGUS_MAX_CONCURRENCY=4
ARGUS_BROWSER_MAX_CONCURRENCY=2
ARGUS_FAST_MAX_REQUESTS_PER_MINUTE=120
ARGUS_BROWSER_MAX_REQUESTS_PER_MINUTE=30
ARGUS_PER_DOMAIN_DELAY_SECONDS=1.0
ARGUS_THROTTLED_DOMAINS=
ARGUS_THROTTLE_BASE_DELAY_SECONDS=2
ARGUS_THROTTLE_MAX_DELAY_SECONDS=60

# Discovery providers are ordered fallbacks. SearXNG is preferred when configured.
ARGUS_DISCOVERY_MAX_QUERIES=8
ARGUS_SEARXNG_URL=
ARGUS_SEARXNG_TIMEOUT_SECONDS=15
ARGUS_SEARXNG_MAX_RESULTS_PER_QUERY=10

# Free low-volume Playwright fallback through DuckDuckGo HTML.
# It never bypasses CAPTCHA/anti-bot challenges and may be disabled explicitly.
ARGUS_BROWSER_SERP_ENABLED=true
ARGUS_BROWSER_SERP_MAX_RESULTS_PER_QUERY=5
ARGUS_BROWSER_SERP_WAIT_MS=750

# Optional OpenStreetMap Overpass provider. No public endpoint is enabled by default.
# Configure a self-hosted or explicitly approved Overpass interpreter endpoint.
ARGUS_OVERPASS_URL=
ARGUS_OVERPASS_TIMEOUT_SECONDS=30

ARGUS_OLLAMA_URL=http://127.0.0.1:11434
ARGUS_OLLAMA_MODEL=qwen3:8b
ARGUS_AGENT_BACKEND=browser-use
ARGUS_AGENT_ENABLED=false

# Comma-separated exact hostnames/IPs allowed to bypass public-address SSRF blocking.
# Keep empty unless an explicitly approved internal target is required.
ARGUS_ALLOW_INTERNAL_TARGETS=
