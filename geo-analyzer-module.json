{
  "schema_version": 1,
  "module": {
    "module_id": "argus.web.intelligence",
    "display_name": "ARGUS Web Intelligence",
    "description": "Скрытый инфраструктурный backend сбора и доказательного хранения данных из публичных интернет-источников для серверных аналитических модулей.",
    "module_version": "0.3.0",
    "protocol_version": "1.0.0"
  },
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "install": [
      ["{python}", "-m", "pip", "install", "--disable-pip-version-check", "."],
      ["{python}", "-m", "playwright", "install", "chromium"]
    ]
  },
  "database": {
    "required": true,
    "engine": "postgresql",
    "dsn_env": "GEOANALYZER_DATABASE_DSN",
    "dsn_file_env": "GEOANALYZER_DATABASE_DSN_FILE",
    "migrations": [
      ["{python}", "-m", "argus.runtime_entrypoint", "storage", "migrate"],
      ["{python}", "-m", "argus.runtime_entrypoint", "storage", "check"]
    ]
  },
  "secrets": {"auth_token_file_env": "ARGUS_TOKEN_FILE"},
  "processes": [
    {
      "id": "api",
      "role": "module_api",
      "command": ["{python}", "-m", "argus.runtime_entrypoint", "api", "--host", "127.0.0.1", "--port", "{api_port}"],
      "environment": {
        "ARGUS_EXECUTION_ROLE": "api",
        "ARGUS_STORAGE_BACKEND": "postgresql",
        "ARGUS_WAYBACK_CDX_URL": "https://web.archive.org/cdx/search/cdx",
        "ARGUS_LOG_LEVEL": "INFO",
        "PYTHONUNBUFFERED": "1"
      },
      "health": {"path": "/v1/health", "authenticated": true}
    },
    {
      "id": "worker",
      "role": "worker",
      "command": ["{python}", "-m", "argus.runtime_entrypoint", "worker", "--probe-host", "127.0.0.1", "--probe-port", "{worker_probe_port}"],
      "environment": {
        "ARGUS_EXECUTION_ROLE": "worker",
        "ARGUS_STORAGE_BACKEND": "postgresql",
        "ARGUS_WAYBACK_CDX_URL": "https://web.archive.org/cdx/search/cdx",
        "ARGUS_LOG_LEVEL": "INFO",
        "PYTHONUNBUFFERED": "1"
      },
      "health": {"path": "/readyz", "port": "worker_probe_port", "authenticated": false}
    }
  ],
  "ports": {
    "api": {"placeholder": "api_port", "preferred": 9180, "host": "127.0.0.1"},
    "worker_probe": {"placeholder": "worker_probe_port", "preferred": 9181, "host": "127.0.0.1"}
  },
  "integration": {
    "endpoint_process": "api",
    "endpoint_port": "api_port",
    "endpoint_scheme": "http",
    "timeout_seconds": 7200,
    "auto_enable_after_healthcheck": true
  }
}
